{
    "folders": [
        {
            "name": "Terrane",
            "path": "."
        }
    ],
    "settings": {
        "files.associations": {
            "*.trn": "terrane"
        }
    },
    "launch": {
        "version": "0.2.0",
        "configurations": [
            {
                "name": "Develop Terrane syntax highlighter",
                "type": "extensionHost",
                "request": "launch",
                "args": [
                    "--extensionDevelopmentPath=${workspaceFolder:Terrane}/editors/vscode"
                ]
            }
        ]
    }
}