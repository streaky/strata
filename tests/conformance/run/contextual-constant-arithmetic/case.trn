namespace contextual-constant-arithmetic
from /core/types import int8, int32, float32

function third float32
  return 1 / 3

function bounded int32
  return 1

function main
  reduced int8 = (1000 - 900)
  integral int = 4.0
  quotient int = (1 / 3)
  ratio float32 = (1 / 3)
  rounded int = ratio.round
  print; reduced
  print; integral
  print; quotient
  print; ratio
  print; rounded
  print; (127 is a int8)
  print; (128 is a int8)
  print; (bounded;)
  print; (third;)
