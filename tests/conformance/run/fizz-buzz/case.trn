namespace fizz-buzz
from /core output import .print
print = .print

function main
  number int = 1
  while number <= 15
    if number % 15 == 0
      print; 'FizzBuzz'
    else if number % 3 == 0
      print; 'Fizz'
    else if number % 5 == 0
      print; 'Buzz'
    else
      print; number
    number++
