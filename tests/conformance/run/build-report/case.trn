namespace build-report
from /core output import .print
print = .print

function report; name string, passed bool, attempts int = 1
  if passed
    print; (name.concat; ': passed in ', attempts, ' attempt(s)')
  else
    print; (name.concat; ': failed')

function main
  report; 'lexer', true
  report; 'parser', true, 2
  title string = 'Terrane'
  print; (title.concat; ' length: ', title.length)
