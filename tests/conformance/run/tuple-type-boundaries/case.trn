namespace tuple-type-boundaries
from /core/collections import list, tuple

function echo tuple of int; values tuple of int
  return values

function nested list of tuple of int; values list of tuple of int
  return values

function main
  pair tuple of int = tuple; 1, 2
  returned tuple of int = echo; pair
  print; returned.length, returned[0], returned[1]
  empty tuple of int = tuple
  print; empty.length
  groups list of tuple of int = list; (tuple; 3, 4), (tuple; 5)
  echoed list of tuple of int = nested; groups
  print; echoed.length, echoed[0][1], echoed[1][0]
