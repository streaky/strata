namespace descriptor-semantics
from /core/types import int8 as byte, int8 as other-byte
function accepts bool; item int
  print; item
  return item is a int
function same-type bool; left int, right int
  print; left
  print; right
  return left.type is right.type
function different-type bool; left int, right string
  print; left
  print; right
  return left.type is right.type
function main
  print; (accepts; 1)
  print; (byte is byte)
  print; (byte is other-byte)
  value float = 1.0
  print; (value is a float64)
  print; (value.type is float64)
  print; (float is float64)
  print; (same-type; 2, 3)
  print; (different-type; 4, 'five')
