// fork.c lines 1352-1808

function get-task-exe-file file; task task-struct
    exe-file file = none
    mm mm-struct

    if (task.flags & pf-kthread) != 0
        return none

    task-lock; task
    mm = task.mm
    if mm != none
        exe-file = get-mm-exe-file; mm
    task-unlock; task
    return exe-file

/**
 * get_task_mm - acquire a reference to the task's mm
 * @task: The task.
 *
 * Returns %NULL if the task has no mm.  Checks PF_KTHREAD (meaning
 * this kernel workthread has transiently adopted a user mm with kthread_use_mm,
