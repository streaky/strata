export-symbol-gpl; put-task-struct-rcu-cb

function arch-task-cache-init void
    none
init; arch-task-cache-init
weak; arch-task-cache-init

// set_max_threads
function set-max-threads void; max-threads-suggested unsigned-int
    threads u64
    nr-pages unsigned-long = memblock-estimated-nr-free-pages;

    // The number of threads shall be limited such that the thread
    // structures may only consume a small part of the available memory.
    if (fls64; nr-pages) + (fls64; page-size) > 64
        threads = max-thread-id-space
    else
        threads = div64-u64; (convert; u64, nr-pages) * (convert; u64, page-size), (convert; u64, thread-size) * (convert; unsigned-long, 8)

    if threads > max-threads-suggested
        threads = max-threads-suggested

    max-threads = clamp-t; u64, threads, min-threads, max-thread-id-space
internal-linkage; set-max-threads
init; set-max-threads

when build; arch-wants-dynamic-task-struct
    // Initialized by the architecture:
    arch-task-struct-size int = 0
    read-mostly; arch-task-struct-size

function task-struct-whitelist void; offset ref unsigned-long, size ref unsigned-long
    // Fetch thread_struct whitelist for the architecture.
    arch-thread-struct-whitelist; offset, size

    // Handle zero-sized whitelist or empty thread_struct, otherwise
    // adjust offset to position of thread_struct in task_struct.
    if unlikely; size == 0
        offset = 0
    else
        unsafe
            offset = offset + (offset-of; task-struct, thread)
internal-linkage; task-struct-whitelist
init; task-struct-whitelist

function fork-init void
    i int

    when build; arch-min-taskalign
        none
    else
        arch-min-taskalign int = 0

    align int = max-t; int, l1-cache-bytes, arch-min-taskalign
    useroffset unsigned-long
    usersize unsigned-long

    // create a slab on which task_structs can be allocated
    task-struct-whitelist; ref useroffset, ref usersize
    task-struct-cachep = kmem-cache-create-usercopy; "task_struct", arch-task-struct-size, align, slab-panic | slab-account, useroffset, usersize, none

    // do the arch specific task caches init
    arch-task-cache-init;

    set-max-threads; max-thread-id-space

    init-task.signal.rlim[rlimit-nproc].rlim-cur = max-threads / 2
    init-task.signal.rlim[rlimit-nproc].rlim-max = max-threads / 2
