    warn-on; (refcount-read; ref tsk.usage) != 0
    warn-on; tsk == current

    unwind-task-free; tsk
    io-uring-free; tsk
    cgroup-task-free; tsk
    task-numa-free; tsk, true
    security-task-free; tsk
    exit-creds; tsk
    delayacct-tsk-free; tsk
    put-signal-struct; tsk.signal
    sched-core-free; tsk
    free-task; tsk
export-symbol-gpl; put-task-struct

function put-task-struct-rcu-cb void; rhp ref rcu-head
