namespace linux kernel fork

use system linux-kernel
from /linux kernel import .per-cpu, .cacheline-aligned, .weak, .inline, .static, .syscall, .latent-entropy, .init

/*
 * Native Strata stress-test translation of Linux kernel/fork.c.
 *
 * The system package supplies the kernel ABI, types, constants, linker
 * attributes, configuration features, and architecture hooks. C identifiers
 * are exposed as injective kebab-case adapter names.
 *
 * This translation deliberately uses `when build; feature` for kernel
 * configuration, `label`/`goto` for exact failure-unwind order, and narrow
 * `unsafe` blocks around raw layout, pointer, and ABI operations. It also
 * pressure-tests core `ref` identity separately from package-owned borrowed,
 * userspace, raw-address, array-view, callable-ABI, and scoped-guard types.
 */

// fork.c lines 1-451
// SPDX-License-Identifier: GPL-2.0-only
/*
 *  linux/kernel/fork.c
 *
 *  Copyright (C) 1991, 1992  Linus Torvalds
 */

/*
 *  'fork.c' contains the help-routines for the 'fork' system call
 * (see also entry.S and others).
 * Fork is rather simple, once you get the hang of it, but the memory
 * management can be a bitch. See 'mm/memory.c': 'copy_page_range()'
 */

// For dup_mmap().

constant create-trace-points boolean = true

/*
 * Minimum number of threads to boot the kernel
 */
constant min-threads int = 20

/*
 * Maximum number of threads
 */
constant max-thread-id-space int = futex-tid-mask

/*
 * Protected counters by write_lock_irq(&tasklist_lock)
 */
global total-forks unsigned-long = 0 // Handle normal Linux uptimes.
global nr-threads int = 0            // The idle threads do not count..

private global max-threads int = 0   // tunable limit on nr_threads

private function named-array-index array-entry of const-string; index int, spelling const-string
    return .array-entry; index=index, value=spelling

private constant resident-page-types array of const-string =
    .array;
        named-array-index; mm-filepages, "MM_FILEPAGES"
        named-array-index; mm-anonpages, "MM_ANONPAGES"
        named-array-index; mm-swapents, "MM_SWAPENTS"
        named-array-index; mm-shmempages, "MM_SHMEMPAGES"

per-cpu global process-counts unsigned-long = 0

cacheline-aligned global tasklist-lock rwlock = define-rwlock;

when build; config-prove-rcu
    function lockdep-tasklist-lock-is-held int
        return lockdep-is-held; ref tasklist-lock

    export-symbol-gpl; lockdep-tasklist-lock-is-held

function nr-processes int
    cpu int
    total int = 0

    for cpu in for-each-possible-cpu;
        total = total + per-cpu; process-counts, cpu

    return total

weak function arch-release-task-struct void; tsk task-struct
    return

private global task-struct-cachep kmem-cache|none = none

private inline function alloc-task-struct-node task-struct|none; node int
    unsafe
        return kmem-cache-alloc-node; task-struct-cachep, gfp-kernel, node

private inline function free-task-struct void; tsk task-struct
    unsafe
        kmem-cache-free; task-struct-cachep, tsk

when build; config-vmap-stack
    /*
     * vmalloc() is a bit slow, and calling vfree() enough times will force a TLB
     * flush.  Try to minimize the number of calls by caching stacks.
     */
    constant nr-cached-stacks int = 2

    private per-cpu global cached-stacks array of vm-struct|none, nr-cached-stacks =
        .array;
            none
            none

    /*
     * Allocated stacks are cached and later reused by new threads, so memcg
     * accounting is performed by the code assigning/releasing stacks to tasks.
     * We need a zeroed memory without __GFP_ACCOUNT.
     */
    constant gfp-vmap-stack gfp-flags =
        gfp-kernel | gfp-zero | gfp-skip-kasan

    class vm-stack
        field rcu rcu-head
        field stack-vm-area vm-struct

    private function alloc-thread-stack-node-from-cache vm-struct|none; tsk task-struct, node int
        vm-area vm-struct|none
        i unsigned-int

        /*
         * If the node has memory, we are guaranteed the stacks are backed by local pages.
         * Otherwise the pages are arbitrary.
         *
         * Note that depending on cpuset it is possible we will get migrated to a different
         * node immediately after allocating here, so this does *not* guarantee locality for
         * arbitrary callers.
         */
        preempt-scope = scoped-guard; preempt
        try
            if node != numa-no-node and numa-node-id; != node
                return none

            for i = 0; i < nr-cached-stacks; i = i + 1
                vm-area = this-cpu-xchg; cached-stacks[i], none
                if vm-area
                    return vm-area
        finally
            preempt-scope.release;

        return none

    private function try-release-thread-stack-to-cache boolean; vm-area vm-struct
        i unsigned-int
        nid int

        /*
         * Don't cache stacks if any of the pages don't match the local domain, unless
         * there is no local memory to begin with.
         *
         * Note that lack of local memory does not automatically mean it makes no difference
         * performance-wise which other domain backs the stack. In this case we are merely
         * trying to avoid constantly going to vmalloc.
         */
        preempt-scope = scoped-guard; preempt
        try
            nid = numa-node-id;
            if node-state; nid, n-memory
                for i = 0; i < vm-area.nr-pages; i = i + 1
                    page page = vm-area.pages[i]
                    if page-to-nid; page != nid
                        return false

            for i = 0; i < nr-cached-stacks; i = i + 1
                tmp vm-struct|none = none

                if this-cpu-try-cmpxchg; cached-stacks[i], ref tmp, vm-area
                    return true
        finally
            preempt-scope.release;

        return false

    private function thread-stack-free-rcu void; rh rcu-head
        vm-stack vm-stack
        unsafe
            vm-stack = container-of; rh, vm-stack, rcu

        vm-area vm-struct = vm-stack.stack-vm-area

        if try-release-thread-stack-to-cache; vm-stack.stack-vm-area
            return

        unsafe
            vfree; vm-area.addr

    private function thread-stack-delayed-free void; tsk task-struct
        vm-stack vm-stack
        unsafe
            vm-stack = tsk.stack

        vm-stack.stack-vm-area = tsk.stack-vm-area
        call-rcu; ref vm-stack.rcu, thread-stack-free-rcu

    private function free-vm-stack-cache int; cpu unsigned-int
        cached-vm-stack-areas array-ref of vm-struct|none
        unsafe
            cached-vm-stack-areas = per-cpu-ptr; cached-stacks, cpu

        i int

        for i = 0; i < nr-cached-stacks; i = i + 1
            vm-area vm-struct|none = cached-vm-stack-areas[i]

            if not vm-area
                continue

            unsafe
                vfree; vm-area.addr
            cached-vm-stack-areas[i] = none

        return 0

    private function memcg-charge-kernel-stack int; vm-area vm-struct
        i int
        ret int
        nr-charged int = 0

        bug-on; vm-area.nr-pages != thread-size / page-size

        for i = 0; i < thread-size / page-size; i = i + 1
            ret = memcg-kmem-charge-page; vm-area.pages[i], gfp-kernel, 0
            if ret
                goto err
            nr-charged = nr-charged + 1

        return 0

        label err
        for i = 0; i < nr-charged; i = i + 1
            memcg-kmem-uncharge-page; vm-area.pages[i], 0
        return ret

    private function alloc-thread-stack-node int; tsk task-struct, node int
        vm-area vm-struct|none
        stack raw-address of void|none

        vm-area = alloc-thread-stack-node-from-cache; tsk, node
        if vm-area
            if memcg-charge-kernel-stack; vm-area
                unsafe
                    vfree; vm-area.addr
                return -enomem

            // Reset stack metadata.
            if not kasan-hw-tags-enabled;
                unsafe
                    kasan-unpoison-range; vm-area.addr, thread-size

            unsafe
                stack = kasan-reset-tag; vm-area.addr

            // Clear stale pointers from reused stack.
            unsafe
                clear-pages; vm-area.addr, vm-area.nr-pages

            tsk.stack-vm-area = vm-area
            tsk.stack = stack
            return 0

        return-address raw-address of void
        unsafe
            return-address = builtin-return-address; 0
            stack = vmalloc-node;
                thread-size,
                thread-align,
                gfp-vmap-stack,
                node,
                return-address

        if not stack
            return -enomem

        unsafe
            vm-area = find-vm-area; stack

        if memcg-charge-kernel-stack; vm-area
            unsafe
                vfree; stack
            return -enomem

        /*
         * We can't call find_vm_area() in interrupt context, and
         * free_thread_stack() can be called in interrupt context,
         * so cache the vm_struct.
         */
        tsk.stack-vm-area = vm-area
        unsafe
            stack = kasan-reset-tag; stack
        tsk.stack = stack
        return 0

    private function free-thread-stack void; tsk task-struct
        if not try-release-thread-stack-to-cache; tsk.stack-vm-area
            thread-stack-delayed-free; tsk

        tsk.stack = none
        tsk.stack-vm-area = none

else
    /*
     * Allocate pages if THREAD_SIZE is >= PAGE_SIZE, otherwise use a
     * kmemcache based allocator.
     */
    when build; thread-size >= page-size
        private function thread-stack-free-rcu void; rh rcu-head
            page page
            unsafe
                page = virt-to-page; rh
                free-pages; page, thread-size-order

        private function thread-stack-delayed-free void; tsk task-struct
            rh rcu-head
            unsafe
                rh = tsk.stack

            call-rcu; rh, thread-stack-free-rcu

        private function alloc-thread-stack-node int; tsk task-struct, node int
            page page|none =
                alloc-pages-node; node, threadinfo-gfp, thread-size-order

            if likely; page
                stack-address raw-address of void
                unsafe
                    stack-address = page-address; page
                    tsk.stack = kasan-reset-tag; stack-address
                return 0

            return -enomem

        private function free-thread-stack void; tsk task-struct
            thread-stack-delayed-free; tsk
            tsk.stack = none

    else
        private global thread-stack-cache kmem-cache|none = none

        private function thread-stack-free-rcu void; rh rcu-head
            unsafe
                kmem-cache-free; thread-stack-cache, rh

        private function thread-stack-delayed-free void; tsk task-struct
            rh rcu-head
            unsafe
                rh = tsk.stack

            call-rcu; rh, thread-stack-free-rcu

        private function alloc-thread-stack-node int; tsk task-struct, node int
            stack raw-address of unsigned-long|none

            unsafe
                stack = kmem-cache-alloc-node;
                    thread-stack-cache,
                    threadinfo-gfp,
                    node
                stack = kasan-reset-tag; stack

            tsk.stack = stack

            if stack
                return 0
            else
                return -enomem

// fork.c lines 452-900

function free-thread-stack void; tsk ref task-struct
    thread-stack-delayed-free; tsk
    tsk.stack = none
internal-linkage; free-thread-stack

function thread-stack-cache-init void
    thread-stack-cache = kmem-cache-create-usercopy; "thread_stack", thread-size, thread-size, 0, 0, thread-size, none
    bug-on; thread-stack-cache == none

// End of THREAD_SIZE >= PAGE_SIZE conditional.
// End of CONFIG_VMAP_STACK conditional.

// SLAB cache for signal_struct structures (tsk->signal)
signal-cachep ref kmem-cache = none
internal-linkage; signal-cachep

// SLAB cache for sighand_struct structures (tsk->sighand)
sighand-cachep ref kmem-cache = none

// SLAB cache for files_struct structures (tsk->files)
files-cachep ref kmem-cache = none

// SLAB cache for fs_struct structures (tsk->fs)
fs-cachep ref kmem-cache = none

// SLAB cache for mm_struct structures (tsk->mm)
mm-cachep ref kmem-cache = none
internal-linkage; mm-cachep

function account-kernel-stack void; tsk ref task-struct, account int
    if is-enabled; config-vmap-stack
        vm-area ref vm-struct = task-stack-vm-area; tsk
        i int

        for i = 0; i < thread-size / page-size; i = i + 1
            mod-lruvec-page-state; vm-area.pages[i], nr-kernel-stack-kb, account * (page-size / 1024)
    else
        stack raw-address of opaque = task-stack-page; tsk

        // All stack pages are in the same node.
        mod-lruvec-kmem-state; stack, nr-kernel-stack-kb, account * (thread-size / 1024)
internal-linkage; account-kernel-stack

function exit-task-stack-account void; tsk ref task-struct
    account-kernel-stack; tsk, -1

    if is-enabled; config-vmap-stack
        vm-area ref vm-struct
        i int

        vm-area = task-stack-vm-area; tsk
        for i = 0; i < thread-size / page-size; i = i + 1
            memcg-kmem-uncharge-page; vm-area.pages[i], 0

function release-task-stack void; tsk ref task-struct
    if warn-on; (read-once; tsk.state) != task-dead
        return // Better to leak the stack than to free prematurely

    free-thread-stack; tsk
internal-linkage; release-task-stack

when build; thread-info-in-task
    function put-task-stack void; tsk ref task-struct
        if refcount-dec-and-test; ref tsk.stack-refcount
            release-task-stack; tsk

function free-task void; tsk ref task-struct
    when build; seccomp
        warn-on-once; tsk.seccomp.filter

    release-user-cpus-ptr; tsk
    scs-release; tsk

    when build; thread-info-in-task
        // If the task had a separate stack allocation, it should be gone
        // by now.
        warn-on-once; (refcount-read; ref tsk.stack-refcount) != 0
    else
        // The task is finally done with both the stack and thread_info,
        // so free both.
        release-task-stack; tsk

    rt-mutex-debug-task-free; tsk
    ftrace-graph-exit-task; tsk
    arch-release-task-struct; tsk
    if (tsk.flags & pf-kthread) != 0
        free-kthread-struct; tsk
    bpf-task-storage-free; tsk
    put-task-exec-state; (rcu-access-pointer; tsk.exec-state)
    free-task-struct; tsk
export-symbol; free-task

function dup-mm-exe-file void; mm ref mm-struct, oldmm ref mm-struct
    exe-file ref file

    exe-file = get-mm-exe-file; oldmm
    rcu-init-pointer; ref mm.exe-file, exe-file
    // We depend on the oldmm having properly denied write access to the
    // exe_file already.
    if exe-file != none and (exe-file-deny-write-access; exe-file) != 0
        pr-warn-once; "exe_file_deny_write_access() failed in %s\n", func

when build; mmu
    function mm-alloc-pgd int; mm ref mm-struct
        mm.pgd = pgd-alloc; mm
        if unlikely; mm.pgd == none
            return -enomem
        return 0
    internal-linkage; mm-alloc-pgd
    inline; mm-alloc-pgd

    function mm-free-pgd void; mm ref mm-struct
        pgd-free; mm, mm.pgd
    internal-linkage; mm-free-pgd
    inline; mm-free-pgd
else
    function mm-alloc-pgd int; mm ref mm-struct
        return 0
    internal-linkage; mm-alloc-pgd
    inline; mm-alloc-pgd

    function mm-free-pgd void; mm ref mm-struct
        none
    internal-linkage; mm-free-pgd
    inline; mm-free-pgd

when build; mm-id
    mm-ida ida = define-ida;
    internal-linkage; mm-ida

    function mm-alloc-id int; mm ref mm-struct
        ret int

        ret = ida-alloc-range; ref mm-ida, mm-id-min, mm-id-max, gfp-kernel
        if ret < 0
            return ret
        mm.mm-id = ret
        return 0
    internal-linkage; mm-alloc-id
    inline; mm-alloc-id

    function mm-free-id void; mm ref mm-struct
        constant id mm-id = mm.mm-id

        mm.mm-id = mm-id-dummy
        if id == mm-id-dummy
            return
        if warn-on-once; id < mm-id-min or id > mm-id-max
            return
        ida-free; ref mm-ida, id
    internal-linkage; mm-free-id
    inline; mm-free-id
else
    function mm-alloc-id int; mm ref mm-struct
        return 0
    internal-linkage; mm-alloc-id
    inline; mm-alloc-id

    function mm-free-id void; mm ref mm-struct
        none
    internal-linkage; mm-free-id
    inline; mm-free-id

function check-mm void; mm ref mm-struct
    i int

    build-bug-on-msg; (array-size; resident-page-types) != nr-mm-counters, "Please make sure 'struct resident_page_types[]' is updated as well"

    for i = 0; i < nr-mm-counters; i = i + 1
        x long = percpu-counter-sum; ref mm.rss-stat[i]

        if unlikely; x != 0
            pr-alert; "BUG: Bad rss-counter state mm:%p type:%s val:%ld Comm:%s Pid:%d\n", mm, resident-page-types[i], x, current.comm, (task-pid-nr; current)

    if (mm-pgtables-bytes; mm) != 0
        pr-alert; "BUG: non-zero pgtables_bytes on freeing mm: %ld\n", (mm-pgtables-bytes; mm)

    when build; transparent-hugepage
        when build; split-pmd-ptlocks
            none
        else
            vm-bug-on-mm; mm.pmd-huge-pte, mm
internal-linkage; check-mm

function allocate-mm ref mm-struct
    return kmem-cache-alloc; mm-cachep, gfp-kernel
internal-linkage; allocate-mm
inline; allocate-mm

function free-mm void; mm ref mm-struct
    kmem-cache-free; mm-cachep, mm
internal-linkage; free-mm
inline; free-mm

function do-check-lazy-tlb void; arg borrowed-ref of opaque
    mm borrowed-ref of mm-struct
    unsafe
        mm = cast-reference; mm-struct, arg

    warn-on-once; current.active-mm == mm
internal-linkage; do-check-lazy-tlb

function do-shoot-lazy-tlb void; arg borrowed-ref of opaque
    mm borrowed-ref of mm-struct
    unsafe
        mm = cast-reference; mm-struct, arg

    if current.active-mm == mm
        warn-on-once; current.mm != none
        current.active-mm = ref init-mm
        switch-mm; mm, ref init-mm, current
internal-linkage; do-shoot-lazy-tlb

function cleanup-lazy-tlbs void; mm ref mm-struct
    if not (is-enabled; config-mmu-lazy-tlb-shootdown)
        // In this case, lazy tlb mms are refounted and would not reach
        // __mmdrop until all CPUs have switched away and mmdrop()ed.
        return

    // Lazy mm shootdown does not refcount "lazy tlb mm" usage, rather it
    // requires lazy mm users to switch to another mm when the refcount
    // drops to zero, before the mm is freed. This requires IPIs here to
    // switch kernel threads to init_mm.
    //
    // archs that use IPIs to flush TLBs can piggy-back that lazy tlb mm
    // switch with the final userspace teardown TLB flush which leaves the
    // mm lazy on this CPU but no others, reducing the need for additional
    // IPIs here. There are cases where a final IPI is still required here,
    // such as the final mmdrop being performed on a different CPU than the
    // one exiting, or kernel threads using the mm when userspace exits.
    //
    // IPI overheads have not found to be expensive, but they could be
    // reduced in a number of possible ways, for example (roughly
    // increasing order of complexity):
    // - The last lazy reference created by exit_mm() could instead switch
    //   to init_mm, however it's probable this will run on the same CPU
    //   immediately afterwards, so this may not reduce IPIs much.
    // - A batch of mms requiring IPIs could be gathered and freed at once.
    // - CPUs store active_mm where it can be remotely checked without a
    //   lock, to filter out false-positives in the cpumask.
    // - After mm_users or mm_count reaches zero, switching away from the
    //   mm could clear mm_cpumask to reduce some IPIs, perhaps together
    //   with some batching or delaying of the final IPIs.
    // - A delayed freeing and RCU-like quiescing sequence based on mm
    //   switching to avoid IPIs completely.
    unsafe
        on-each-cpu-mask; (mm-cpumask; mm), do-shoot-lazy-tlb, (erase-reference-type; mm), 1
    if is-enabled; config-debug-vm-shoot-lazies
        unsafe
            on-each-cpu; do-check-lazy-tlb, (erase-reference-type; mm), 1
internal-linkage; cleanup-lazy-tlbs

// Called when the last reference to the mm
// is dropped: either by a lazy thread or by
// mmput. Free the page directory and the mm.
function mmdrop void; mm ref mm-struct
    bug-on; mm == ref init-mm
    warn-on-once; mm == current.mm

    // Ensure no CPUs are using this as their lazy tlb mm
    cleanup-lazy-tlbs; mm

    warn-on-once; mm == current.active-mm
    mm-destroy-sched; mm
    mm-free-pgd; mm
    mm-free-id; mm
    destroy-context; mm
    mmu-notifier-subscriptions-destroy; mm
    check-mm; mm
    mm-pasid-drop; mm
    mm-destroy-cid; mm
    percpu-counter-destroy-many; mm.rss-stat, nr-mm-counters

    free-mm; mm
export-symbol-gpl; mmdrop

function mmdrop-async-fn void; work ref work-struct
    mm ref mm-struct

    unsafe
        mm = container-of; work, mm-struct, async-put-work
    mmdrop; mm
internal-linkage; mmdrop-async-fn

function mmdrop-async void; mm ref mm-struct
    if unlikely; (atomic-dec-and-test; ref mm.mm-count)
        init-work; ref mm.async-put-work, mmdrop-async-fn
        schedule-work; ref mm.async-put-work
internal-linkage; mmdrop-async

function free-signal-struct void; sig ref signal-struct
