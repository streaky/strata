    p.flags = p.flags & ~(pf-superpriv | pf-wq-worker | pf-idle | pf-no-setaffinity)
    p.flags = p.flags | pf-forknoexec
    init-list-head; ref p.children
    init-list-head; ref p.sibling
    rcu-copy-process; p
    p.vfork-done = none
    spin-lock-init; ref p.alloc-lock

    init-sigpending; ref p.pending

    p.gtime = 0
    p.stime = 0
    p.utime = 0
    when build; config-arch-has-scaled-cputime
        p.stimescaled = 0
        p.utimescaled = 0

    prev-cputime-init; ref p.prev-cputime

    when build; config-virt-cpu-accounting-gen
        seqcount-init; ref p.vtime.seqcount
        p.vtime.starttime = 0
        p.vtime.state = vtime-inactive

    when build; config-io-uring
        p.io-uring = none
