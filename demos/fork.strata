    set-userns-rlimit-max; ref init-user-ns, ucount-rlimit-nproc, rlim-infinity
    set-userns-rlimit-max; ref init-user-ns, ucount-rlimit-msgqueue, rlim-infinity
    set-userns-rlimit-max; ref init-user-ns, ucount-rlimit-sigpending, rlim-infinity
