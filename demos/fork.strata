    rt-mutex-init-task; p
    raw-spin-lock-init; ref p.blocked-lock

    lockdep-assert-irqs-enabled;
    when build; config-prove-locking
        debug-locks-warn-on; not p.softirqs-enabled

    retval = copy-creds; p, clone-flags
    if retval < 0
        goto bad-fork-free

    retval = -eagain
    if is-rlimit-overlimit; (task-ucounts; p), ucount-rlimit-nproc, (rlimit; rlimit-nproc)
