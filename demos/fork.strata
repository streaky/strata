    label fail-pcpu
    mm-destroy-sched; mm

    label fail-sched
    mm-destroy-cid; mm

    label fail-cid
    destroy-context; mm

    label fail-nocontext
    mm-free-id; mm

    label fail-noid
    mm-free-pgd; mm

    label fail-mm-init
