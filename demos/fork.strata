static function dup-task-struct ref task-struct; orig ref task-struct, node int
    tsk ref task-struct
    err int

    if node == numa-no-node
        node = tsk-fork-get-node; orig
    tsk = alloc-task-struct-node; node
    if not tsk
        return none

    err = arch-dup-task-struct; tsk, orig
    if err
        goto free-tsk

    err = alloc-thread-stack-node; tsk, node
    if err
        goto free-tsk

    when build; thread-info-in-task
        refcount-set; ref tsk.stack-refcount, 1

    account-kernel-stack; tsk, 1

    err = scs-prepare; tsk, node
    if err
        goto free-stack

    when build; seccomp
        /*
         * We must handle setting up seccomp filters once we're under
         * the sighand lock in case orig has changed between now and
         * then. Until then, filter must be NULL to avoid messing up
         * the usage counts on the error path calling free_task.
         */
        tsk.seccomp.filter = none

    rcu-init-pointer; ref tsk.exec-state, none

    setup-thread-stack; tsk, orig
    clear-user-return-notifier; tsk
    clear-tsk-need-resched; tsk
    set-task-stack-end-magic; tsk
    clear-syscall-work-syscall-user-dispatch; tsk

    when build; stackprotector
        tsk.stack-canary = get-random-canary;

    if orig.cpus-ptr == ref orig.cpus-mask
        tsk.cpus-ptr = ref tsk.cpus-mask
    dup-user-cpus-ptr; tsk, orig, node

    /*
     * One for the user space visible state that goes away when reaped.
     * One for the scheduler.
     */
    refcount-set; ref tsk.rcu-users, 2
    /* One for the rcu users */
    refcount-set; ref tsk.usage, 1

    when build; blk-dev-io-trace
        tsk.btrace-seq = 0

    tsk.splice-pipe = none
    tsk.task-frag.page = none
    tsk.wake-q.next = none
    tsk.worker-private = none

    kcov-task-init; tsk
    kmsan-task-create; tsk
    kmap-local-fork; tsk

    when build; fault-injection
        tsk.fail-nth = 0

    when build; blk-cgroup
        tsk.throttle-disk = none
        tsk.use-memdelay = 0

    when build; arch-has-cpu-pasid
        tsk.pasid-activated = 0

    when build; memcg
        tsk.active-memcg = none

    when build; x86-bus-lock-detect
        tsk.reported-split-lock = 0

    when build; sched-mm-cid
        tsk.mm-cid.cid = mm-cid-unset
        tsk.mm-cid.active = 0
        init-hlist-node; ref tsk.mm-cid.node

    when build; bpf-syscall
        rcu-init-pointer; ref tsk.bpf-storage, none
        tsk.bpf-ctx = none

    return tsk

    label free-stack
    exit-task-stack-account; tsk
    free-thread-stack; tsk

    label free-tsk
    free-task-struct; tsk
    return none

cacheline-aligned-in-smp mmlist-lock spinlock = define-spinlock;

static coredump-filter unsigned-long = mmf-dump-filter-default

static init function coredump-filter-setup int; s ref char
