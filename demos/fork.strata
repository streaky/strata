            exit-shm; current
            shm-init-task; current

        if new-nsproxy != none
            switch-task-namespaces; current, move new-nsproxy
            new-nsproxy = none

        task-lock; current

        if new-fs != none
            fs = current.fs
            read-seqlock-excl; ref fs.seq
            current.fs = new-fs
            fs.users = fs.users - 1
            if fs.users != 0
                new-fs = none
            else
                new-fs = fs
            read-sequnlock-excl; ref fs.seq

        if new-fd != none
            swap; ref current.files, ref new-fd

        task-unlock; current

        if new-cred != none
            /* Install the new user namespace */
            commit-creds; move new-cred
            new-cred = none

    perf-event-namespaces; current

    label bad-unshare-cleanup-nsproxy
    if new-nsproxy != none
        put-nsproxy; move new-nsproxy

    label bad-unshare-cleanup-cred
    if new-cred != none
        put-cred; move new-cred

    label bad-unshare-cleanup-fd
    if new-fd != none
        put-files-struct; move new-fd

    label bad-unshare-cleanup-fs
    if new-fs != none
        free-fs-struct; move new-fs

    label bad-unshare-out
    return err

syscall function unshare long; unshare-flags unsigned-long
    return (ksys-unshare; unshare-flags)

/*
 *	Helper to unshare the files of the current task.
 *	We don't want to expose copy_files internals to
 *	the exec layer of the kernel.
 */
function unshare-files int;
    task ref task-struct = current
    old ref files-struct
    copy ref files-struct = none
    error int

    error = (unshare-fd; clone-files, ref copy)
    if error != 0 or copy == none
        return error

    old = task.files
    task-lock; task
    task.files = move copy
    task-unlock; task
    put-files-struct; move old
    return 0

static function sysctl-max-threads int; table borrowed-ref of ctl-table, write int, buffer user-ref of opaque, lenp borrowed-ref of size-t, ppos borrowed-ref of loff-t
    t ctl-table
    ret int
    threads int = max-threads
    min int = 1
    max int = max-thread-id-space

    t = table
    t.data = ref threads
    t.extra1 = ref min
    t.extra2 = ref max

    unsafe
        ret = (proc-dointvec-minmax; ref t, write, buffer, lenp, ppos)
    if ret != 0 or write == 0
        return ret

    max-threads = threads

    return 0

static constant fork-sysctl-table array of ctl-table =
    .array;
        .ctl-table;
            procname = "threads-max"
            data = none
            maxlen = (size-of; int)
            mode = 0o644
            proc-handler = ref sysctl-max-threads

static init function init-fork-sysctl int;
    register-sysctl-init; "kernel", ref fork-sysctl-table
    return 0

subsys-initcall; ref init-fork-sysctl

// Preserve C/link spellings independently of source and generated Rust names.
native-name; cleanup-sighand, "__cleanup_sighand"
native-name; delayed-free-task, "__delayed_free_task"
native-name; mmdrop, "__mmdrop"
native-name; mmput, "__mmput"
native-name; put-task-struct, "__put_task_struct"
native-name; put-task-struct-rcu-cb, "__put_task_struct_rcu_cb"
