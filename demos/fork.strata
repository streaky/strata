    atomic-set; ref mm.mm-count, 1
    seqcount-init; ref mm.write-protect-seq
    mmap-init-lock; mm
    init-list-head; ref mm.mmlist
    mm-pgtables-bytes-init; mm
    mm.map-count = 0
    mm.locked-vm = 0
    atomic64-set; ref mm.pinned-vm, 0

    unsafe
        memset; ref mm.rss-stat, 0, (size-of; mm.rss-stat)

    spin-lock-init; ref mm.page-table-lock
    spin-lock-init; ref mm.arg-lock
    mm-init-cpumask; mm
    mm-init-aio; mm
    mm-init-owner; mm, p
    mm-pasid-init; mm
    rcu-init-pointer; ref mm.exe-file, none
