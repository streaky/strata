    task-io-accounting-init; ref p.ioac
    acct-clear-integrals; p

    posix-cputimers-init; ref p.posix-cputimers
    tick-dep-init-task; p

    p.io-context = none
    audit-set-context; p, none
    cgroup-fork; p
    if args.kthread
