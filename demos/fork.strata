            current.signal.quick-threads = current.signal.quick-threads + 1
            atomic-inc; ref current.signal.live
            refcount-inc; ref current.signal.sigcnt
            task-join-group-stop; p
            list-add-tail-rcu; ref p.thread-node, ref p.signal.thread-head

        attach-pid; p, pidtype-pid
        nr-threads = nr-threads + 1

