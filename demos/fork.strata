        init-task-pid; p, pidtype-pid, pid
        if thread-group-leader; p
            init-task-pid; p, pidtype-tgid, pid
            init-task-pid; p, pidtype-pgid, (task-pgrp; current)
            init-task-pid; p, pidtype-sid, (task-session; current)

            if is-child-reaper; pid
                ns pid-namespace = ns-of-pid; pid

                assert-exclusive-writer; ref ns.child-reaper
                write-once; ref ns.child-reaper, p
                p.signal.flags = p.signal.flags | signal-unkillable

            p.signal.shared-pending.signal = delayed.signal
            p.signal.tty = tty-kref-get; current.signal.tty
