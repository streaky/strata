     * sched_ext needs @p to be associated with its cgroup in its post_fork
     * hook. cgroup_post_fork() should come before sched_post_fork().
     */
    cgroup-post-fork; p, args
    sched-post-fork; p
    perf-event-fork; p

    trace-task-newtask; p, clone-flags
    uprobe-copy-process; p, clone-flags
    user-events-fork; p, clone-flags

    copy-oom-score-adj; clone-flags, p

    return p

    label bad-fork-core-free
    sched-core-free; p
    spin-unlock; ref current.sighand.siglock
    write-unlock-irq; ref tasklist-lock

    label bad-fork-cancel-cgroup
    cgroup-cancel-fork; p, args

    label bad-fork-put-pidfd
    if clone-flags & clone-pidfd
        fput; pidfile
        put-unused-fd; pidfd

    label bad-fork-free-pid
    if pid != ref init-struct-pid
        free-pid; pid

    label bad-fork-cleanup-thread
    exit-thread; p

    label bad-fork-cleanup-io
    if p.io-context
        exit-io-context; p

    label bad-fork-cleanup-namespaces
    exit-nsproxy-namespaces; p

    label bad-fork-cleanup-mm
    if p.mm
        mm-clear-owner; p.mm, p
        mmput; p.mm

    label bad-fork-cleanup-signal
    if not (clone-flags & clone-thread)
        free-signal-struct; p.signal

    label bad-fork-cleanup-sighand
    cleanup-sighand; p.sighand

    label bad-fork-cleanup-fs
    exit-fs; p /* blocking */

    label bad-fork-cleanup-files
    exit-files; p /* blocking */

    label bad-fork-cleanup-semundo
    exit-sem; p

    label bad-fork-cleanup-security
    security-task-free; p

    label bad-fork-cleanup-audit
    audit-free; p

    label bad-fork-cleanup-perf
    perf-event-free-task; p

    label bad-fork-sched-cancel-fork
    sched-cancel-fork; p

    label bad-fork-cleanup-policy
    lockdep-free-task; p
    when build; config-numa
        mpol-put; p.mempolicy

    label bad-fork-cleanup-delayacct
    io-uring-free; p
    delayacct-tsk-free; p

    label bad-fork-cleanup-count
    dec-rlimit-ucounts; (task-ucounts; p), ucount-rlimit-nproc, 1
    exit-cred-namespaces; p
    exit-creds; p

    label bad-fork-free
    write-once; ref p.state, task-dead
    exit-task-stack-account; p
    put-task-stack; p
    delayed-free-task; p

    label fork-out
    spin-lock-irq; ref current.sighand.siglock
    hlist-del-init; ref delayed.node
    spin-unlock-irq; ref current.sighand.siglock
    return err-ptr; retval

@static
@inline
function init-idle-pids void; idle task-struct
    type pid-type

    for type = pidtype-pid; type < pidtype-max; type = type + 1
        init-hlist-node; ref idle.pid-links[type] /* not really needed */
        init-task-pid; idle, type, ref init-struct-pid

@static
function idle-dummy int; dummy opaque
    /* This function is never called */
    return 0

@init
function fork-idle task-struct; cpu int
    task task-struct
    args kernel-clone-args = .kernel-clone-args;
        flags=clone-vm,
        fn=ref idle-dummy,
        fn-arg=none,
        kthread=1,
        idle=1

    task = copy-process; ref init-struct-pid, 0, (cpu-to-node; cpu), ref args
    if not (is-err; task)
        init-idle-pids; task
        init-idle; task, cpu

    return task

/*
 * This is like kernel_clone(), but shaved down and tailored to just
 * creating io_uring workers. It returns a created task, or an error pointer.
 * The returned task is inactive, and the caller must fire it up through
 * wake_up_new_task(p). All signals are blocked in the created task.
 */
function create-io-thread task-struct; fn (function int; value opaque), arg opaque, node int
    flags unsigned-long =
        clone-fs | clone-files | clone-sighand | clone-thread |
        clone-io | clone-vm | clone-untraced
    args kernel-clone-args = .kernel-clone-args;
        flags=flags,
        fn=fn,
        fn-arg=arg,
        io-thread=1,
        user-worker=1

    return copy-process; none, 0, node, ref args

/*
 *  Ok, this is the main fork-routine.
 *
 * It copies the process, and if successful kick-starts
 * it and waits for it to finish using the VM if required.
 */
function kernel-clone pid-t; args kernel-clone-args

// fork.c lines 2695-3142
    clone-flags u64 = args.flags
    vfork completion
    pid ref pid
    p ref task-struct
    trace int = 0
    nr pid-t

    /*
     * Creating an empty mount namespace implies creating a new mount
     * namespace.  Set this before copy_process() so that the
     * CLONE_NEWNS|CLONE_FS mutual exclusion check works correctly.
     */
    if clone-flags & clone-empty-mntns
        clone-flags = clone-flags | clone-newns
        args.flags = clone-flags

    /*
     * For legacy clone() calls, CLONE_PIDFD uses the parent_tid argument
     * to return the pidfd. Hence, CLONE_PIDFD and CLONE_PARENT_SETTID are
     * mutually exclusive. With clone3() CLONE_PIDFD has grown a separate
     * field in struct clone_args and it still doesn't make sense to have
     * them both point at the same memory location. Performing this check
     * here has the advantage that we don't need to have a separate helper
     * to check for legacy clone().
     */
    if (clone-flags & clone-pidfd) and
       (clone-flags & clone-parent-settid) and
       (args.pidfd == args.parent-tid)
        return -einval

    if not (valid-signal; args.exit-signal)
        return -einval

    /*
     * Determine whether and which event to report to ptracer.  When
     * called from kernel_thread or CLONE_UNTRACED is explicitly
     * requested, no event is reported; otherwise, report if the event
     * for the type of forking is enabled.
     */
    if not (clone-flags & clone-untraced)
        if clone-flags & clone-vfork
            trace = ptrace-event-vfork
        else if args.exit-signal != sigchld
            trace = ptrace-event-clone
        else
            trace = ptrace-event-fork

        if likely; not (ptrace-event-enabled; current, trace)
            trace = 0

    p = copy-process; none, trace, numa-no-node, args
    add-latent-entropy;

    if is-err; p
        return ptr-err; p

    /*
     * Do this prior waking up the new thread - the thread pointer
     * might get invalid after that point, if the thread exits quickly.
     */
    trace-sched-process-fork; current, p

    pid = get-task-pid; p, pidtype-pid
    nr = pid-vnr; pid

    if clone-flags & clone-parent-settid
        unsafe
            put-user; nr, args.parent-tid

    if clone-flags & clone-vfork
        p.vfork-done = ref vfork
        init-completion; ref vfork
        get-task-struct; p

    if (is-enabled; config-lru-gen-walks-mmu) and not (clone-flags & clone-vm)
        /* lock the task to synchronize with memcg migration */
        task-lock; p
        lru-gen-add-mm; p.mm
        task-unlock; p

    wake-up-new-task; p

    /* forking complete and child started to run, tell ptracer */
    if unlikely; trace
        ptrace-event-pid; trace, pid

    if clone-flags & clone-vfork
        if not (wait-for-vfork-done; p, ref vfork)
            ptrace-event-pid; ptrace-event-vfork-done, pid

    put-pid; pid
    return nr

/*
 * Create a kernel thread.
 */
function kernel-thread pid-t; fn function from c-pointer of opaque to int, arg c-pointer of opaque, name borrowed-ref of const-char, flags unsigned-long
    args kernel-clone-args = .kernel-clone-args;
        flags=((flags | clone-vm | clone-untraced) & ~csignal)
        exit-signal=(flags & csignal)
        fn=fn
        fn-arg=arg
        name=name
        kthread=1

    return kernel-clone; ref args

/*
 * Create a user mode thread.
 */
function user-mode-thread pid-t; fn function from c-pointer of opaque to int, arg c-pointer of opaque, flags unsigned-long
    args kernel-clone-args = .kernel-clone-args;
        flags=((flags | clone-vm | clone-untraced) & ~csignal)
        exit-signal=(flags & csignal)
        fn=fn
        fn-arg=arg

    return kernel-clone; ref args

when build; arch-want-sys-fork
    syscall function fork long;
        when build; config-mmu
            args kernel-clone-args = .kernel-clone-args;
                exit-signal=sigchld

            return kernel-clone; ref args
        else
            /* can not support in nommu mode */
            return -einval

when build; arch-want-sys-vfork
    syscall function vfork long;
        args kernel-clone-args = .kernel-clone-args;
            flags=(clone-vfork | clone-vm)
            exit-signal=sigchld

        return kernel-clone; ref args

when build; arch-want-sys-clone
    when build; config-clone-backwards
        syscall function clone long; clone-flags unsigned-long, newsp unsigned-long, parent-tidptr user-ref of int, tls unsigned-long, child-tidptr user-ref of int
            args kernel-clone-args = .kernel-clone-args;
                flags=((lower-32-bits; clone-flags) & ~csignal)
                pidfd=parent-tidptr
                child-tid=child-tidptr
                parent-tid=parent-tidptr
                exit-signal=((lower-32-bits; clone-flags) & csignal)
                stack=newsp
                tls=tls

            return kernel-clone; ref args
    else
        when build; config-clone-backwards2
            syscall function clone long; newsp unsigned-long, clone-flags unsigned-long, parent-tidptr user-ref of int, child-tidptr user-ref of int, tls unsigned-long
                args kernel-clone-args = .kernel-clone-args;
                    flags=((lower-32-bits; clone-flags) & ~csignal)
                    pidfd=parent-tidptr
                    child-tid=child-tidptr
                    parent-tid=parent-tidptr
                    exit-signal=((lower-32-bits; clone-flags) & csignal)
                    stack=newsp
                    tls=tls

                return kernel-clone; ref args
        else
            when build; config-clone-backwards3
                syscall function clone long; clone-flags unsigned-long, newsp unsigned-long, stack-size int, parent-tidptr user-ref of int, child-tidptr user-ref of int, tls unsigned-long
                    args kernel-clone-args = .kernel-clone-args;
                        flags=((lower-32-bits; clone-flags) & ~csignal)
                        pidfd=parent-tidptr
                        child-tid=child-tidptr
                        parent-tid=parent-tidptr
                        exit-signal=((lower-32-bits; clone-flags) & csignal)
                        stack=newsp
                        tls=tls

                    return kernel-clone; ref args
            else
                syscall function clone long; clone-flags unsigned-long, newsp unsigned-long, parent-tidptr user-ref of int, child-tidptr user-ref of int, tls unsigned-long
                    args kernel-clone-args = .kernel-clone-args;
                        flags=((lower-32-bits; clone-flags) & ~csignal)
                        pidfd=parent-tidptr
                        child-tid=child-tidptr
                        parent-tid=parent-tidptr
                        exit-signal=((lower-32-bits; clone-flags) & csignal)
                        stack=newsp
                        tls=tls

                    return kernel-clone; ref args

static noinline function copy-clone-args-from-user int; kargs kernel-clone-args, uargs user-ref of clone-args, usize size-t
    err int
    args clone-args
    kset-tid ref pid-t = kargs.set-tid

    unsafe
        build-bug-on; (offsetofend; clone-args, tls) != clone-args-size-ver0
        build-bug-on; (offsetofend; clone-args, set-tid-size) != clone-args-size-ver1
        build-bug-on; (offsetofend; clone-args, cgroup) != clone-args-size-ver2
        build-bug-on; (sizeof; clone-args) != clone-args-size-ver2

    if unlikely; usize > page-size
        return -e2big
    if unlikely; usize < clone-args-size-ver0
        return -einval

    unsafe
        err = copy-struct-from-user; ref args, sizeof; args, uargs, usize
    if err
        return err

    if unlikely; args.set-tid-size > max-pid-ns-level
        return -einval

    if unlikely; not args.set-tid and args.set-tid-size > 0
        return -einval

    if unlikely; args.set-tid and args.set-tid-size == 0
        return -einval

    /*
     * Verify that higher 32bits of exit_signal are unset
     */
    if unlikely; args.exit-signal & ~(u64; csignal)
        return -einval

    if (args.flags & clone-into-cgroup) and
       (args.cgroup > int-max or usize < clone-args-size-ver2)
        return -einval

    unsafe
        kargs = .kernel-clone-args;
            flags=args.flags
            pidfd=(u64-to-user-ptr; args.pidfd)
            child-tid=(u64-to-user-ptr; args.child-tid)
            parent-tid=(u64-to-user-ptr; args.parent-tid)
            exit-signal=args.exit-signal
            stack=args.stack
            stack-size=args.stack-size
            tls=args.tls
            set-tid-size=args.set-tid-size
            cgroup=args.cgroup

    unsafe
        if args.set-tid and
           (copy-from-user; kset-tid,
                            u64-to-user-ptr; args.set-tid,
                            kargs.set-tid-size * (sizeof; pid-t))
            return -efault

    kargs.set-tid = kset-tid

    return 0

/**
 * clone3_stack_valid - check and prepare stack
 * @kargs: kernel clone args
 *
 * Verify that the stack arguments userspace gave us are sane.
 * In addition, set the stack direction for userspace since it's easy for us to
 * determine.
 */
static inline function clone3-stack-valid bool; kargs kernel-clone-args
    if kargs.stack == 0
        if kargs.stack-size > 0
            return false
    else
        if kargs.stack-size == 0
            return false

        unsafe
            if not (access-ok; reinterpret-user-reference; void, kargs.stack, kargs.stack-size)
                return false

        when build; config-stack-growsup
            none
        else
            kargs.stack = kargs.stack + kargs.stack-size

    return true

static function clone3-args-valid bool; kargs kernel-clone-args
    /* Verify that no unknown flags are passed along. */
    if kargs.flags &
       ~(clone-legacy-flags | clone-clear-sighand |
         clone-into-cgroup | clone-autoreap | clone-nnp |
         clone-pidfd-autokill | clone-empty-mntns)
        return false

    /*
     * - make the CLONE_DETACHED bit reusable for clone3
     * - make the CSIGNAL bits reusable for clone3
     */
    if kargs.flags & (clone-detached | (csignal & ~clone-newtime))
        return false

    if (kargs.flags & (clone-sighand | clone-clear-sighand)) ==
       (clone-sighand | clone-clear-sighand)
        return false

    if (kargs.flags & (clone-thread | clone-parent)) and kargs.exit-signal
        return false

    if not (clone3-stack-valid; kargs)
        return false

    return true

/**
 * sys_clone3 - create a new process with specific properties
 * @uargs: argument structure
 * @size:  size of @uargs
 *
 * clone3() is the extensible successor to clone()/clone2().
 * It takes a struct as argument that is versioned by its size.
 *
 * Return: On success, a positive PID for the child process.
 *         On error, a negative errno number.
 */
syscall function clone3 long; uargs user-ref of clone-args, size size-t
    err int

    kargs kernel-clone-args
    set-tid array of pid-t = .array; length=max-pid-ns-level

    when build; arch-broken-sys-clone3
        build-warning; "clone3() entry point is missing, please fix"
        return -enosys

    kargs.set-tid = ref set-tid

    err = copy-clone-args-from-user; ref kargs, uargs, size
    if err
        return err

    if not (clone3-args-valid; ref kargs)
        return -einval

    return kernel-clone; ref kargs

function walk-process-tree void; top borrowed-ref of task-struct, visitor proc-visitor, data c-pointer of opaque
    leader borrowed-ref of task-struct
    parent borrowed-ref of task-struct
    child borrowed-ref of task-struct
    res int

    read-lock; ref tasklist-lock
    top = top.group-leader
    leader = top

    label down
    for parent in (for-each-thread; leader)
        for child in (list-for-each-entry; ref parent.children, sibling)
            res = visitor; child, data
            if res
                if res < 0
                    goto out
                leader = child
                goto down

            label up
            none

    if leader != top
        child = leader
        parent = child.real-parent
        leader = parent.group-leader
        goto up

    label out
    read-unlock; ref tasklist-lock

when build; arch-min-mmstruct-align
    none
else
    arch-min-mmstruct-align unsigned-int = 0

static function sighand-ctor void; data borrowed-ref of opaque
    sighand borrowed-ref of sighand-struct

    unsafe
        sighand = reinterpret-reference; sighand-struct, data

    spin-lock-init; ref sighand.siglock
    init-waitqueue-head; ref sighand.signalfd-wqh

init function mm-cache-init void;
    mm-size unsigned-int

    /*
     * The mm_cpumask is located at the end of mm_struct, and is
     * dynamically sized based on the maximum CPU number this system
     * can have, taking hotplug into account (nr_cpu_ids).
     */
    unsafe
        mm-size = (sizeof; mm-struct) + (cpumask-size;) + (mm-cid-size;)

    unsafe
        mm-cachep = kmem-cache-create-usercopy;
            "mm_struct",
            mm-size,
            arch-min-mmstruct-align,
            slab-hwcache-align | slab-panic | slab-account,
            offsetof; mm-struct, saved-auxv,
            sizeof-field; mm-struct, saved-auxv,
            none

init function proc-caches-init void;
    unsafe
        sighand-cachep = kmem-cache-create;
            "sighand_cache",
            sizeof; sighand-struct,
            0,
            slab-hwcache-align | slab-panic | slab-typesafe-by-rcu |
            slab-account,
            sighand-ctor

        signal-cachep = kmem-cache-create;
            "signal_cache",
            sizeof; signal-struct,
            0,
            slab-hwcache-align | slab-panic | slab-account,
            none

    exec-state-init;

    unsafe
        files-cachep = kmem-cache-create;
            "files_cache",
            sizeof; files-struct,
            0,
            slab-hwcache-align | slab-panic | slab-account,
            none

        fs-cachep = kmem-cache-create;
            "fs_cache",
            sizeof; fs-struct,
            0,
            slab-hwcache-align | slab-panic | slab-account,
            none

    mmap-init;
    nsproxy-cache-init;

/*
 * Check constraints on flags passed to the unshare system call.
 */
static function check-unshare-flags int; unshare-flags unsigned-long

// fork.c lines 3143-3409
    if (unshare-flags & ~(clone-thread | clone-fs | clone-sighand |
            clone-vm | clone-files | clone-sysvsem |
            clone-ns-all | unshare-empty-mntns)) != 0
        return -einval

    /*
     * Not implemented, but pretend it works if there is nothing
     * to unshare.  Note that unsharing the address space or the
     * signal handlers also need to unshare the signal queues (aka
     * CLONE_THREAD).
     */
    if (unshare-flags & (clone-thread | clone-sighand | clone-vm)) != 0
        if not (thread-group-empty; current)
            return -einval

    if (unshare-flags & (clone-sighand | clone-vm)) != 0
        if (refcount-read; ref current.sighand.count) > 1
            return -einval

    if (unshare-flags & clone-vm) != 0
        if not (current-is-single-threaded;)
            return -einval

    return 0

/*
 * Unshare the filesystem structure if it is being shared
 */
static function unshare-fs int; unshare-flags unsigned-long, new-fsp ref ref fs-struct
    fs ref fs-struct = current.fs

    if (unshare-flags & clone-fs) == 0 or fs == none
        return 0

    /* don't need lock here; in the worst case we'll do useless copy */
    if (unshare-flags & clone-newns) == 0 and fs.users == 1
        return 0

    new-fsp = (copy-fs-struct; fs)
    if new-fsp == none
        return -enomem

    return 0

/*
 * Unshare file descriptor table if it is being shared
 */
static function unshare-fd int; unshare-flags unsigned-long, new-fdp ref ref files-struct
    fd ref files-struct = current.files

    if (unshare-flags & clone-files) != 0 and
            (fd != none and (atomic-read; ref fd.count) > 1)
        unsafe
            fd = (dup-fd; fd, none)
            if is-err; fd
                return (ptr-err; fd)
        new-fdp = fd

    return 0

/*
 * unshare allows a process to 'unshare' part of the process
 * context which was originally shared using clone.  copy_*
 * functions used by kernel_clone() cannot be used here directly
 * because they modify an inactive task_struct that is being
 * constructed. Here we are modifying the current, active,
 * task_struct.
 */
function ksys-unshare int; unshare-flags unsigned-long
    fs ref fs-struct
    new-fs ref fs-struct = none
    new-fd ref files-struct = none
    new-cred ref cred = none
    new-nsproxy ref nsproxy = none
    do-sysvsem int = 0
    err int

    /*
     * If unsharing a user namespace must also unshare the thread group
     * and unshare the filesystem root and working directories.
     */
    if (unshare-flags & clone-newuser) != 0
        unshare-flags = unshare-flags | clone-thread | clone-fs

    /*
     * If unsharing vm, must also unshare signal handlers.
     */
    if (unshare-flags & clone-vm) != 0
        unshare-flags = unshare-flags | clone-sighand

    /*
     * If unsharing a signal handlers, must also unshare the signal queues.
     */
    if (unshare-flags & clone-sighand) != 0
        unshare-flags = unshare-flags | clone-thread

    /*
     * If unsharing namespace, must also unshare filesystem information.
     */
    if (unshare-flags & unshare-empty-mntns) != 0
        unshare-flags = unshare-flags | clone-newns
    if (unshare-flags & clone-newns) != 0
        unshare-flags = unshare-flags | clone-fs

    err = (check-unshare-flags; unshare-flags)
    if err != 0
        goto bad-unshare-out

    /*
     * CLONE_NEWIPC must also detach from the undolist: after switching
     * to a new ipc namespace, the semaphore arrays from the old
     * namespace are unreachable.
     */
    if (unshare-flags & (clone-newipc | clone-sysvsem)) != 0
        do-sysvsem = 1

    err = (unshare-fs; unshare-flags, ref new-fs)
    if err != 0
        goto bad-unshare-out

    err = (unshare-fd; unshare-flags, ref new-fd)
    if err != 0
        goto bad-unshare-cleanup-fs

    err = (unshare-userns; unshare-flags, ref new-cred)
    if err != 0
        goto bad-unshare-cleanup-fd

    err = (unshare-nsproxy-namespaces;
        unshare-flags, ref new-nsproxy, new-cred, new-fs)
    if err != 0
        goto bad-unshare-cleanup-cred

    if new-cred != none
        err = (set-cred-ucounts; new-cred)
        if err != 0
            goto bad-unshare-cleanup-nsproxy

    if new-fs != none or new-fd != none or do-sysvsem != 0 or
            new-cred != none or new-nsproxy != none
        if do-sysvsem != 0
            /*
             * CLONE_SYSVSEM is equivalent to sys_exit().
             */
            exit-sem; current

        if (unshare-flags & clone-newipc) != 0
