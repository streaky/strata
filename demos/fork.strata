    retval = security-task-alloc; p, clone-flags
    if retval
        goto bad-fork-cleanup-audit
    retval = copy-semundo; clone-flags, p
    if retval
        goto bad-fork-cleanup-security
    retval = copy-files; clone-flags, p, args.no-files
    if retval
        goto bad-fork-cleanup-semundo
    retval = copy-fs; clone-flags, p
    if retval
        goto bad-fork-cleanup-files
    retval = copy-sighand; clone-flags, p
    if retval
        goto bad-fork-cleanup-fs
    retval = copy-signal; clone-flags, p
    if retval
        goto bad-fork-cleanup-sighand
    retval = copy-mm; clone-flags, p
    if retval
        goto bad-fork-cleanup-signal
    retval = copy-namespaces; clone-flags, p
    if retval
