    mm = allocate-mm;
    if mm == none
        goto fail-nomem

    unsafe
        memcpy; mm, oldmm, (size-of; mm)

    if not (mm-init; mm, tsk)
        goto fail-nomem

    uprobe-start-dup-mmap;
    err = dup-mmap; mm, oldmm
    if err != 0
        goto free-pt
    uprobe-end-dup-mmap;

    mm.hiwater-rss = get-mm-rss; mm
    mm.hiwater-vm = mm.total-vm

    if mm.binfmt != none and not (try-module-get; mm.binfmt.module)
        goto free-pt

