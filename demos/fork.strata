private function may-access-mm bool; mm mm-struct, task task-struct, mode unsigned-int
    if mm == current.mm
        return true
    if ptrace-may-access; task, mode
        return true
    if (mode & ptrace-mode-read) != 0 and (perfmon-capable;)
        return true
    return false

function mm-access mm-struct; task task-struct, mode unsigned-int
    mm mm-struct
