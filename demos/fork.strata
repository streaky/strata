/**
 * set_mm_exe_file - change a reference to the mm's executable file
 * @mm: The mm to change.
 * @new_exe_file: The new file to use.
 *
 * This changes mm's executable file (shown as symlink /proc/[pid]/exe).
 *
 * Main users are mmput() and sys_execve(). Callers prevent concurrent
 * invocations: in mmput() nobody alive left, in execve it happens before
 * the new mm is made visible to anyone.
 *
 * Can only fail if new_exe_file != NULL.
 */
function set-mm-exe-file int; mm ref mm-struct, new-exe-file ref file
    old-exe-file ref file

    /*
     * It is safe to dereference the exe_file without RCU as
     * this function is only called if nobody else can access
     * this mm -- see comment above for justification.
     */
    unsafe
        old-exe-file = rcu-dereference-raw; mm.exe-file

    if new-exe-file
        /*
         * We expect the caller (i.e., sys_execve) to already denied
         * write access, so this is unlikely to fail.
         */
        if unlikely; (exe-file-deny-write-access; new-exe-file)
            return -eacces
        get-file; new-exe-file

    rcu-assign-pointer; ref mm.exe-file, new-exe-file

    if old-exe-file
        exe-file-allow-write-access; old-exe-file
        fput; old-exe-file

    return 0

/**
 * replace_mm_exe_file - replace a reference to the mm's executable file
 * @mm: The mm to change.
 * @new_exe_file: The new file to use.
 *
 * This changes mm's executable file (shown as symlink /proc/[pid]/exe).
 *
 * Main user is sys_prctl(PR_SET_MM_MAP/EXE_FILE).
 */
function replace-mm-exe-file int; mm ref mm-struct, new-exe-file ref file
    vma ref vm-area-struct
    old-exe-file ref file
    ret int = 0

    /* Forbid mm->exe_file change if old file still mapped. */
    old-exe-file = get-mm-exe-file; mm
    if old-exe-file
        vmi vma-iterator = vma-iterator; mm, 0
        mmap-read-lock; mm

        for vma in vmi
            if not vma.vm-file
                continue

            if path-equal; ref vma.vm-file.f-path, ref old-exe-file.f-path
                ret = -ebusy
                break

        mmap-read-unlock; mm
        fput; old-exe-file

        if ret
            return ret

    ret = exe-file-deny-write-access; new-exe-file
    if ret
        return -eacces

    get-file; new-exe-file

    /* set the new file */
    mmap-write-lock; mm

    unsafe
        old-exe-file = rcu-dereference-raw; mm.exe-file

    rcu-assign-pointer; ref mm.exe-file, new-exe-file
    mmap-write-unlock; mm

    if old-exe-file
        exe-file-allow-write-access; old-exe-file
        fput; old-exe-file

    return 0

/**
 * get_mm_exe_file - acquire a reference to the mm's executable file
 * @mm: The mm of interest.
 *
 * Returns %NULL if mm has no associated executable file.
 * User must release file via fput().
 */
function get-mm-exe-file ref file; mm ref mm-struct
    exe-file ref file

    rcu-read-lock;
    exe-file = get-file-rcu; ref mm.exe-file
    rcu-read-unlock;
    return exe-file

/**
 * get_task_exe_file - acquire a reference to the task's executable file
 * @task: The task.
 *
 * Returns %NULL if task's mm (if any) has no associated executable file or
 * this is a kernel thread with borrowed mm (see the comment above get_task_mm).
 * User must release file via fput().
