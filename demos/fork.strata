        p.tgid = p.pid

    p.nr-dirtied = 0
    p.nr-dirtied-pause = 128 >> (page-shift - 10)
    p.dirty-paused-when = 0

    p.pdeath-signal = 0
    p.task-works = none
    clear-posix-cputimers-work; p

    when build; config-kretprobes
