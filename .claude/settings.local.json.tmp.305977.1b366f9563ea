{
  "permissions": {
    "allow": [
      "Bash(grep -E '^[0-9a-f]{7} |strata_program$')",
      "Bash(git ls-tree *)",
      "Bash(git rev-list *)",
      "Bash(git cat-file *)",
      "Bash(sort -k2 -nr)",
      "Bash(grep -n '^#\\\\{1,3\\\\} ' docs/language-spec-and-compiler-architecture-draft.md)",
      "Bash(git diff *)",
      "Bash(timeout 300 cargo test -p strata-compiler --test lexer)",
      "Bash(timeout 600 cargo test --workspace)",
      "Bash(timeout 600 cargo clippy --workspace --all-targets)",
      "Bash(python3 -)",
      "Bash(timeout 300 cargo clippy --workspace --all-targets)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  }
}
