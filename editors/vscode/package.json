{
  "name": "terrane-language",
  "displayName": "Terrane Language",
  "description": "Syntax highlighting and basic editor support for Terrane",
  "version": "0.0.1",
  "publisher": "terrane",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "terrane",
        "aliases": [
          "Terrane",
          "terrane"
        ],
        "extensions": [
          ".trn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "terrane",
        "scopeName": "source.trn",
        "path": "./syntaxes/terrane.tmLanguage.json"
      }
    ]
  }
}
