{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Strata",
  "scopeName": "source.strata",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#objectNames" },
    { "include": "#members" },
    { "include": "#calls" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.strata",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.strata" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.strata" }
          }
        },
        {
          "name": "comment.line.double-slash.strata",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.strata",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.strata",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.strata",
              "match": "\\\\(?:\\\\|'|n|r|t)"
            }
          ]
        },
        {
          "name": "string.quoted.double.strata",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.strata",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(function)\\s+([A-Za-z][A-Za-z0-9]*(?:[+*/%<>-]+[A-Za-z0-9]+)*)",
          "captures": {
            "1": { "name": "storage.type.function.strata" },
            "2": { "name": "entity.name.function.strata" }
          }
        },
        {
          "match": "\\b(class)\\s+([A-Za-z][A-Za-z0-9]*(?:[+*/%<>-]+[A-Za-z0-9]+)*)",
          "captures": {
            "1": { "name": "storage.type.class.strata" },
            "2": { "name": "entity.name.type.class.strata" }
          }
        },
        {
          "match": "\\b(namespace)\\s+([A-Za-z][A-Za-z0-9]*(?:[+*/%<>-]+[A-Za-z0-9]+)*)",
          "captures": {
            "1": { "name": "keyword.other.namespace.strata" },
            "2": { "name": "entity.name.namespace.strata" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.strata",
          "match": "\\b(?:if|else|for|while|try|catch|finally|throw|return|break|continue|goto|label|when|build|in|and|or|not|is)\\b"
        },
        {
          "name": "storage.modifier.strata",
          "match": "\\b(?:public|private|protected|global|constant|static|linear|weak|inline|syscall|per-cpu|cacheline-aligned|internal-linkage|native-name|unsafe|ref|move)\\b"
        },
        {
          "name": "keyword.other.strata",
          "match": "\\b(?:namespace|from|import|as|use|function|class|field|extends|implements|rust)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.strata",
          "match": "\\b(?:true|false|none|this)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.strata",
          "match": "(?<![A-Za-z0-9])0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*"
        },
        {
          "name": "constant.numeric.binary.strata",
          "match": "(?<![A-Za-z0-9])0[bB][01](?:_?[01])*"
        },
        {
          "name": "constant.numeric.strata",
          "match": "(?<![A-Za-z0-9])(?:[0-9](?:_?[0-9])*)(?:\\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?"
        }
      ]
    },
    "objectNames": {
      "patterns": [
        {
          "name": "variable.other.object.strata",
          "match": "(?<![A-Za-z0-9.])\\.[A-Za-z][A-Za-z0-9]*(?:[+*/%<>-]+[A-Za-z0-9]+)*"
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "name": "variable.other.property.strata",
          "match": "(?<=\\.)[A-Za-z][A-Za-z0-9]*(?:[+*/%<>-]+[A-Za-z0-9]+)*"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.strata",
          "match": "\\b[A-Za-z][A-Za-z0-9]*(?:[+*/%<>-]+[A-Za-z0-9]+)*(?=;)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.strata",
          "match": "\\b(?:void|opaque|boolean|bool|byte|char|string|const-string|int|unsigned-int|long|unsigned-long|u8|u16|u32|u64|u128|i8|i16|i32|i64|i128|f32|f64|usize|isize|array|array-ref|borrowed-ref|user-ref|raw-address|c-pointer|function from)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.word.strata",
          "match": "\\b(?:and|or|not|is)\\b"
        },
        {
          "name": "keyword.operator.symbolic.strata",
          "match": "(?:==|!=|<=|>=|<<|>>|[+\\-*/%<>&|^~=])"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.readwrite.strata",
          "match": "\\b[A-Za-z][A-Za-z0-9]*(?:[+*/%<>-]+[A-Za-z0-9]+)*\\b"
        }
      ]
    }
  }
}
